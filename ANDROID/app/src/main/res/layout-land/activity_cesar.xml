<?xml version="1.0" encoding="utf-8"?>

<!--
    Diseño horizontal de la pantalla de descifrado César.
    Permite seleccionar un archivo de texto e introducir
    el desplazamiento necesario para recuperar su contenido.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO -->

    <!-- Imagen de fondo de la biblioteca mágica. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Capa oscura semitransparente para mejorar el contraste. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Contenedor principal vertical de la pantalla. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <!-- CABECERA -->

        <!-- Panel decorativo que contiene el título y subtítulo de César. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/cabecera_orden">

            <!-- Título principal de la herramienta. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cesar_header_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <!-- Subtítulo descriptivo de la herramienta. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cesar_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- TÍTULO DE LA SECCIÓN -->

        <!-- Indica la sección de archivos recibidos. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/cesar_received_files"
            android:textColor="#F5BD36"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center" />

        <!-- INSTRUCCIONES -->

        <!-- Explica al usuario cómo utilizar el descifrado César. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:text="@string/cesar_instructions"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

        <!--
            CONTENEDOR DE LOS DOS PERGAMINOS.
            Distribuye el espacio horizontal disponible entre
            la selección del archivo y la introducción del desplazamiento.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="2dp">

            <!-- PERGAMINO IZQUIERDO: SELECCIÓN DEL ARCHIVO -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">

                <!-- Fondo decorativo del primer pergamino. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fondo_tarjeta_pergamino"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <!-- Contenido interior del pergamino de selección. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="34dp"
                    android:paddingEnd="34dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <!-- Título de la sección de selección de archivos. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cesar_file_section"
                        android:textColor="#09204C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!--
                        Muestra el nombre del archivo TXT seleccionado.
                        Su contenido se actualiza desde CesarActivity.kt.
                        Limita el nombre a dos líneas para evitar desbordamientos.
                    -->
                    <TextView
                        android:id="@+id/tvArchivoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/cesar_no_file_selected"
                        android:textColor="#62513D"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!--
                        Botón que abre el selector de archivos de Android
                        para elegir el documento que se quiere descifrar.
                    -->
                    <Button
                        android:id="@+id/btnSeleccionarArchivo"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="165dp"
                        android:maxWidth="210dp"
                        android:layout_gravity="center"
                        android:text="@string/cesar_select_file"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/azul_hechicero" />

                </LinearLayout>
            </FrameLayout>

            <!-- PERGAMINO DERECHO: DESPLAZAMIENTO -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <!-- Fondo decorativo del segundo pergamino. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fondo_tarjeta_pergamino"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <!-- Contenido interior del pergamino de desplazamiento. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="34dp"
                    android:paddingEnd="34dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <!-- Título de la sección de desplazamiento César. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cesar_key_section"
                        android:textColor="#09204C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!--
                        Campo para introducir el desplazamiento.
                        inputType="number" muestra el teclado numérico.
                        maxLength limita la entrada a dos caracteres.
                        El valor se recoge desde CesarActivity.kt.
                    -->
                    <EditText
                        android:id="@+id/etDesplazamiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/cesar_shift_hint"
                        android:inputType="number"
                        android:maxLength="2"
                        android:singleLine="true"
                        android:gravity="center"
                        android:textColor="#09204C"
                        android:textColorHint="#75634E"
                        android:textSize="16sp"
                        android:backgroundTint="#8B5425"
                        android:padding="5dp" />

                    <!--
                        Botón que inicia el descifrado César.
                        La operación se gestiona desde CesarActivity.kt,
                        utilizando el archivo seleccionado y el desplazamiento.
                    -->
                    <Button
                        android:id="@+id/btnDescifrar"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="165dp"
                        android:maxWidth="210dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="@string/cesar_decrypt_button"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/azul_hechicero" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- BOTÓN VOLVER -->

        <!--
            Botón gráfico para regresar a la pantalla anterior.
            Su comportamiento se controla desde CesarActivity.kt.
        -->
        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/fondo_flecha_volver"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button_back"
            android:padding="0dp" />

    </LinearLayout>
</FrameLayout>
