<?xml version="1.0" encoding="utf-8"?>

<!--
    Diseño horizontal de la pantalla de resultado del descifrado César.
    Muestra el texto recuperado y permite desplazarse por él,
    guardarlo o compartirlo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO -->

    <!-- Imagen de fondo de la biblioteca mágica. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Capa oscura semitransparente para mejorar el contraste. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Contenedor principal vertical de la pantalla. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="5dp">

        <!-- CABECERA -->

        <!-- Panel decorativo con el título y subtítulo del resultado. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/cabecera_orden">

            <!-- Título principal de la pantalla de resultados César. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cesar_result_header_title"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <!-- Línea decorativa dorada debajo del título. -->
            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#F2B82E" />

            <!-- Subtítulo descriptivo de la pantalla de resultados. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/cesar_result_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:gravity="center" />

        </LinearLayout>

        <!-- PERGAMINO DEL RESULTADO -->

        <!--
            Contenedor que ocupa el espacio vertical restante.
            Incluye el fondo decorativo y la zona donde se muestra
            el texto obtenido después del descifrado.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp">

            <!-- Fondo decorativo del pergamino. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo_tarjeta_pergamino"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <!-- CONTENIDO INTERIOR -->

            <!--
                Área interior del pergamino.
                Los márgenes internos mantienen el texto separado
                de los bordes decorativos.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="100dp"
                android:paddingEnd="100dp"
                android:paddingTop="40dp"
                android:paddingBottom="35dp">

                <!-- MENSAJE DE ESTADO -->

                <!--
                    Informa del estado del proceso de descifrado.
                    Inicialmente muestra el mensaje definido en strings.xml.
                    Se actualiza desde CesarResultadoActivity.kt.
                -->
                <TextView
                    android:id="@+id/tvEstadoCesar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/cesar_decrypting"
                    android:textColor="#62513D"
                    android:textSize="14sp"
                    android:visibility="visible" />

                <!-- SCROLL DEL TEXTO DESCIFRADO -->

                <!--
                    Permite desplazarse verticalmente por el texto recuperado.
                    Empieza oculto y se muestra cuando el resultado está disponible.
                    Los indicadores de desplazamiento permanecen visibles
                    mientras el usuario recorre el contenido.
                -->
                <ScrollView
                    android:id="@+id/scrollResultadoCesar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:visibility="gone">

                    <!--
                        Contiene el texto descifrado.
                        Su contenido se establece desde Kotlin.
                        textIsSelectable permite seleccionar y copiar
                        fragmentos del mensaje recuperado.
                    -->
                    <TextView
                        android:id="@+id/tvResultadoCesar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#593719"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"
                        android:textIsSelectable="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                </ScrollView>

            </FrameLayout>

        </FrameLayout>

        <!-- BOTONES GUARDAR Y COMPARTIR -->

        <!-- Contenedor horizontal que agrupa las acciones del resultado. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp">

            <!--
                Botón para guardar el texto descifrado en un archivo.
                La operación se gestiona desde CesarResultadoActivity.kt.
            -->
            <Button
                android:id="@+id/btnGuardarCesar"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/cesar_save_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!--
                Botón para compartir el texto recuperado
                mediante las aplicaciones compatibles de Android.
            -->
            <Button
                android:id="@+id/btnCompartirCesar"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/share_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- BOTÓN VOLVER -->

        <!-- Contenedor que posiciona el botón de regreso en la parte inferior. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:paddingStart="14dp"
            android:gravity="center_vertical">

            <!--
                Botón gráfico para regresar a la pantalla anterior.
                Su comportamiento se controla desde CesarResultadoActivity.kt.
            -->
            <ImageButton
                android:id="@+id/btnVolverResultado"
                android:layout_width="60dp"
                android:layout_height="42dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
