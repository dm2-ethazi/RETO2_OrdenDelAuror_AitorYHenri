<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal de la pantalla -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo de la biblioteca mágica -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Capa semitransparente para oscurecer el fondo y facilitar la lectura -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Contenedor principal que organiza los elementos verticalmente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <!-- CABECERA DE LA APLICACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cabecera_orden">

            <!-- Nombre de la aplicación -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre_aplicacion"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center" />

            <!-- Línea decorativa dorada que separa el nombre del subtítulo -->
            <View
                android:layout_width="55dp"
                android:layout_height="2dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="#F2B82E" />

            <!-- Subtítulo de la aplicación -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo_aplicacion"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:gravity="center" />
        </LinearLayout>

        <!-- TÍTULO DE BIENVENIDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/bienvenida"
            android:textColor="#F5BD36"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Descripción inicial de la aplicación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:text="@string/descripcion_bienvenida"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="1dp" />

        <!-- CONTENEDOR DE LAS OPCIONES EN DOS COLUMNAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!-- COLUMNA DE DESCIFRADO AES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Botón para acceder a la pantalla de descifrado AES -->
                <!-- btnAes permite localizar el botón desde Kotlin -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAes"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/fondo_boton"
                    android:text="@string/titulo_aes"
                    android:textColor="#09204C"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@null" />

                <!-- Descripción de la funcionalidad de descifrado AES -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/descripcion_aes"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Separador vertical entre las dos opciones de descifrado -->
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#F2B82E" />

            <!-- COLUMNA DE DESCIFRADO CÉSAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Botón para acceder a la pantalla de descifrado César -->
                <!-- btnCesar permite localizar el botón desde Kotlin -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCesar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/fondo_boton"
                    android:text="@string/titulo_cesar"
                    android:textColor="#09204C"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@null" />

                <!-- Descripción de la funcionalidad de descifrado César -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/descripcion_cesar"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PIE DE PANTALLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <!-- Nombre de la aplicación mostrado en el pie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre_aplicacion"
                android:textColor="#F5BD36"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Texto adicional del pie de pantalla -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/pie_pantalla"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- BOTÓN DE AJUSTES -->
        <!-- btnAjustes permite abrir la configuración de la aplicación desde Kotlin -->
        <ImageButton
            android:id="@+id/btnAjustes"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="start"
            android:src="@drawable/ic_settings"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:scaleType="fitCenter"
            android:padding="3dp"
            android:contentDescription="@string/settings_button" />

    </LinearLayout>
</FrameLayout>
