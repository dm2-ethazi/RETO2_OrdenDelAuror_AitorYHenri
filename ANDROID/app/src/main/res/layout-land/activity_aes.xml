<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/cabecera_orden">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aes_header_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/aes_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/aes_received_files"
            android:textColor="#F5BD36"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:text="@string/aes_instructions"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="2dp">

            <!-- Pergamino para seleccionar la imagen -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fondo_tarjeta_pergamino"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="34dp"
                    android:paddingEnd="34dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/aes_file_section"
                        android:textColor="#09204C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvArchivoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/aes_no_file_selected"
                        android:textColor="#62513D"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <Button
                        android:id="@+id/btnSeleccionarArchivo"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="165dp"
                        android:maxWidth="210dp"
                        android:layout_gravity="center"
                        android:text="@string/aes_select_image"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/azul_hechicero" />

                </LinearLayout>
            </FrameLayout>

            <!-- Pergamino para introducir la contraseña -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fondo_tarjeta_pergamino"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="34dp"
                    android:paddingEnd="34dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/aes_password_section"
                        android:textColor="#09204C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/etContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/aes_password_hint"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:gravity="center"
                        android:textColor="#09204C"
                        android:textColorHint="#75634E"
                        android:textSize="16sp"
                        android:backgroundTint="#8B5425"
                        android:padding="2dp" />

                    <Button
                        android:id="@+id/btnDescifrar"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="165dp"
                        android:maxWidth="210dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="@string/aes_decrypt_button"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/azul_hechicero" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/fondo_flecha_volver"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button_back"
            android:padding="0dp" />

    </LinearLayout>
</FrameLayout>
