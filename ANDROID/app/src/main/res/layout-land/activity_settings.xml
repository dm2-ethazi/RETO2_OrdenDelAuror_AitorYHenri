<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_biblioteca">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="58dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="8dp">

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/cabecera_orden"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:gravity="center" />

                <View
                    android:layout_width="65dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#C9A45C" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_subtitle"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:gravity="center" />

            </LinearLayout>

            <!-- PANELES EN PARALELO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- IDIOMA -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="230dp"
                    android:layout_weight="0.85"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/fondo_tarjeta_pergamino">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_language_title"
                            android:textColor="#102B59"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/settings_language_description"
                            android:textColor="#68451F"
                            android:textSize="12sp"
                            android:gravity="center" />

                        <Spinner
                            android:id="@+id/spinnerIdioma"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minWidth="150dp"
                            android:maxWidth="210dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/boton_orden"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:popupBackground="#102B59"
                            android:spinnerMode="dropdown" />

                    </LinearLayout>
                </FrameLayout>

                <!-- ACERCA DE: CONTENIDO DESPLAZABLE -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="230dp"
                    android:layout_weight="1.35"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/fondo_tarjeta_pergamino">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="false"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="true"
                        android:paddingStart="65dp"
                        android:paddingEnd="65dp"
                        android:paddingTop="60dp"
                        android:paddingBottom="60dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_about_title"
                                android:textColor="#102B59"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <View
                                android:layout_width="65dp"
                                android:layout_height="2dp"
                                android:layout_marginTop="5dp"
                                android:background="#A66A20" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/settings_about_app"
                                android:textColor="#68451F"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/settings_about_description"
                                android:textColor="#68451F"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="@string/settings_about_developers_title"
                                android:textColor="#102B59"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/settings_about_developers"
                                android:textColor="#68451F"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <View
                                android:layout_width="65dp"
                                android:layout_height="2dp"
                                android:layout_marginTop="6dp"
                                android:background="#A66A20" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/settings_about_languages"
                                android:textColor="#68451F"
                                android:textSize="12sp"
                                android:gravity="center" />

                        </LinearLayout>
                    </ScrollView>
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN VOLVER -->
    <ImageButton
        android:id="@+id/btnVolverAjustes"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/fondo_flecha_volver"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/button_back"
        android:padding="0dp" />

</FrameLayout>