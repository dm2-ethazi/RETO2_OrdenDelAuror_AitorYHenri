<?xml version="1.0" encoding="utf-8"?>

<!--
    Diseño vertical de la pantalla de resultado del descifrado AES.
    Muestra la imagen recuperada, permite desplazarse por ella
    y ofrece opciones para guardar o compartir el resultado.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO -->

    <!-- Imagen de fondo de la biblioteca mágica. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Capa oscura semitransparente para mejorar la lectura. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Contenedor principal vertical de toda la pantalla. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="5dp">

        <!-- CABECERA -->

        <!-- Panel decorativo que contiene el título y subtítulo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/cabecera_orden">

            <!-- Título de la sección de resultados AES. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aes_result_section"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <!-- Línea decorativa dorada debajo del título. -->
            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#F2B82E" />

            <!-- Subtítulo descriptivo de la herramienta. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/aes_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:gravity="center" />

        </LinearLayout>

        <!-- PERGAMINO DEL RESULTADO -->

        <!--
            Contenedor del resultado que ocupa el espacio vertical restante.
            Incluye la imagen de fondo y la zona interior de visualización.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp">

            <!-- Fondo decorativo del pergamino. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/fondo_tarjeta_pergamino" />

            <!-- CONTENIDO INTERIOR -->

            <!--
                Área interior del pergamino.
                Los paddings dejan espacio alrededor del contenido
                para que no se superponga con los bordes decorativos.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="120dp"
                android:paddingEnd="120dp"
                android:paddingTop="40dp"
                android:paddingBottom="35dp">

                <!-- SCROLL DE LA IMAGEN -->

                <!--
                    Permite desplazarse verticalmente por la imagen descifrada.
                    Empieza oculto y se muestra cuando el resultado está disponible.
                    fillViewport hace que el contenido pueda ocupar al menos
                    toda la altura disponible del ScrollView.
                -->
                <ScrollView
                    android:id="@+id/scrollImagenDescifrada"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:visibility="gone">

                    <!--
                        Imagen recuperada después del descifrado AES.
                        Su contenido se establece desde AesResultadoActivity.kt.
                        wrap_content permite conservar su altura necesaria
                        y fitCenter ajusta su visualización al ancho disponible.
                    -->
                    <ImageView
                        android:id="@+id/ivImagenDescifrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/aes_decrypted_image_description"
                        android:scaleType="fitCenter" />

                </ScrollView>

                <!-- MENSAJE DE ESTADO -->

                <!--
                    Muestra información sobre el estado del resultado.
                    Inicialmente indica que se está esperando el descifrado.
                    Se puede actualizar desde AesResultadoActivity.kt.
                    Se muestra mientras el ScrollView permanece oculto.
                -->
                <TextView
                    android:id="@+id/tvEstadoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/aes_waiting_decryption"
                    android:textColor="#62513D"
                    android:textSize="14sp"
                    android:visibility="visible" />

            </FrameLayout>

        </FrameLayout>

        <!-- BOTONES GUARDAR Y COMPARTIR -->

        <!-- Contenedor horizontal que agrupa las acciones disponibles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp">

            <!--
                Botón para guardar la imagen descifrada.
                La operación se gestiona desde AesResultadoActivity.kt.
            -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/aes_save_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!--
                Botón para compartir la imagen descifrada
                mediante las aplicaciones compatibles de Android.
            -->
            <Button
                android:id="@+id/btnCompartir"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/share_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- BOTÓN VOLVER -->

        <!-- Contenedor que posiciona el botón de regreso en la parte inferior. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:paddingStart="14dp"
            android:gravity="center_vertical">

            <!--
                Botón gráfico para regresar a la pantalla anterior.
                Su comportamiento se controla desde AesResultadoActivity.kt.
            -->
            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="60dp"
                android:layout_height="42dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
