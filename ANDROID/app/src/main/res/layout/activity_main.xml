<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_principal">

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@color/azul_hechicero">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_aplicacion"
                    android:textColor="@color/texto_claro"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/dorado_antiguo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitulo_aplicacion"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

            </LinearLayout>

            <!-- Bienvenida -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/bienvenida"
                android:textColor="@color/azul_hechicero"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/descripcion_bienvenida"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <!-- Acceso AES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="30dp">

                <Button
                    android:id="@+id/btnAes"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/titulo_aes"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/boton_orden"
                    android:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/descripcion_aes"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/dorado_antiguo" />

            <!-- Acceso César -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/btnCesar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/titulo_cesar"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/boton_orden"
                    android:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/descripcion_cesar"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Separador del pie -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/dorado_antiguo" />

            <!-- Pie de pantalla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_aplicacion"
                    android:textColor="@color/azul_hechicero"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/pie_pantalla"
                    android:textColor="@color/texto_secundario"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Botón de ajustes inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnAjustes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:contentDescription="@string/settings_button" />

    </LinearLayout>

</LinearLayout>
