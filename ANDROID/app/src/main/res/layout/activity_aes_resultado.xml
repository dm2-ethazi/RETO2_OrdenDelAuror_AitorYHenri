<?xml version="1.0" encoding="utf-8"?>

<!--
    Diseño de la pantalla que muestra el resultado del descifrado AES.
    Incluye la imagen recuperada, su estado y las opciones
    para guardar o compartir el archivo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo de la biblioteca mágica. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Capa oscura para mejorar la visibilidad del contenido. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Contenedor principal vertical de la pantalla. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="5dp">

        <!-- CABECERA -->

        <!-- Panel decorativo con el título y subtítulo de la pantalla. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/cabecera_orden">

            <!-- Título de la sección de resultados. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aes_result_section"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <!-- Línea decorativa dorada bajo el título. -->
            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="#F2B82E" />

            <!-- Subtítulo descriptivo de la herramienta AES. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/aes_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:gravity="center" />

        </LinearLayout>

        <!-- PERGAMINO DEL RESULTADO -->

        <!--
            Contenedor que ocupa el espacio vertical restante.
            Incluye el fondo del pergamino y la zona donde
            se muestra la imagen descifrada o su estado.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="8dp">

            <!-- Imagen decorativa de fondo del pergamino. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/fondo_tarjeta_pergamino" />

            <!-- ZONA INTERIOR -->

            <!--
                Área interior del pergamino.
                Los márgenes internos dejan espacio para
                mostrar el resultado sin ocupar los bordes.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="62dp"
                android:paddingEnd="62dp"
                android:paddingTop="130dp"
                android:paddingBottom="130dp">

                <!--
                    Imagen obtenida tras descifrar el archivo AES.
                    Su contenido se establece desde AesResultadoActivity.kt.
                    Empieza oculta y se muestra cuando hay una imagen disponible.
                -->
                <ImageView
                    android:id="@+id/ivImagenDescifrada"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/aes_decrypted_image_description"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!--
                    Texto que informa del estado del resultado.
                    Se utiliza inicialmente para indicar que se está
                    esperando el descifrado y puede actualizarse desde Kotlin.
                    Permanece visible mientras no se muestra la imagen.
                -->
                <TextView
                    android:id="@+id/tvEstadoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/aes_waiting_decryption"
                    android:textColor="#62513D"
                    android:textSize="14sp"
                    android:visibility="visible" />

            </FrameLayout>

        </FrameLayout>

        <!-- BOTONES GUARDAR Y COMPARTIR -->

        <!-- Contenedor horizontal que agrupa las acciones del resultado. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp">

            <!--
                Botón para guardar la imagen descifrada.
                La acción de guardado se gestiona desde AesResultadoActivity.kt.
            -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/aes_save_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!--
                Botón para compartir la imagen descifrada
                mediante las aplicaciones compatibles de Android.
            -->
            <Button
                android:id="@+id/btnCompartir"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/share_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- BOTÓN VOLVER -->

        <!-- Contenedor que posiciona el botón de regreso en la parte inferior. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingStart="18dp"
            android:gravity="center_vertical">

            <!--
                Botón gráfico para regresar a la pantalla anterior.
                Su comportamiento se controla desde AesResultadoActivity.kt.
            -->
            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
