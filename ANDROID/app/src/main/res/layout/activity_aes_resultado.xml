<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO DE BIBLIOTECA -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:layout_margin="20dp"
            android:background="@drawable/cabecera_orden">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aes_result_section"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="#F2B82E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/aes_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:gravity="center" />

        </LinearLayout>

        <!-- PERGAMINO DEL RESULTADO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo_tarjeta_pergamino"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="65dp"
                android:paddingEnd="65dp"
                android:paddingTop="35dp"
                android:paddingBottom="35dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aes_result_section"
                    android:textColor="#09204C"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvEstadoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/aes_waiting_decryption"
                    android:textColor="#62513D"
                    android:textSize="13sp"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/ivImagenDescifrada"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/aes_decrypted_image_description" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="@string/aes_save_button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/azul_hechicero" />

            </LinearLayout>
        </FrameLayout>

        <!-- VOLVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="65dp"
                android:layout_height="55dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
