<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal de la pantalla de ajustes -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_biblioteca">

    <!-- CONTENIDO DE LA PANTALLA -->
    <!-- Permite desplazar el contenido si no cabe en la pantalla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingTop="20dp"
        android:paddingBottom="75dp">

        <!-- Contenedor vertical que agrupa las diferentes secciones de ajustes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- CABECERA DE LA PANTALLA DE AJUSTES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="35dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/cabecera_orden"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Título de la pantalla obtenido de los recursos de idioma -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:gravity="center" />

                <!-- Línea decorativa que separa el título del subtítulo -->
                <View
                    android:layout_width="65dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#C9A45C" />

                <!-- Subtítulo descriptivo de la pantalla de ajustes -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_subtitle"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:gravity="center" />

            </LinearLayout>

            <!-- PERGAMINO PARA CONFIGURAR EL IDIOMA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/fondo_tarjeta_pergamino">

                <!-- Contenedor de los textos y el selector de idioma -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="42dp"
                    android:paddingEnd="42dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp">

                    <!-- Título de la sección de selección de idioma -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language_title"
                        android:textColor="#102B59"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!-- Explicación de la opción de cambio de idioma -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_language_description"
                        android:textColor="#68451F"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <!-- Selector desplegable para elegir el idioma de la aplicación -->
                    <!-- spinnerIdioma permite acceder al selector desde Kotlin -->
                    <Spinner
                        android:id="@+id/spinnerIdioma"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/boton_orden"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:popupBackground="#102B59"
                        android:spinnerMode="dropdown" />

                </LinearLayout>
            </FrameLayout>

            <!-- PERGAMINO CON LA INFORMACIÓN DE LA APLICACIÓN -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:background="@drawable/fondo_tarjeta_pergamino">

                <!-- Contenedor vertical de la información sobre la aplicación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="42dp"
                    android:paddingEnd="42dp"
                    android:paddingTop="38dp"
                    android:paddingBottom="38dp">

                    <!-- Título de la sección de información -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_title"
                        android:textColor="#102B59"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!-- Separador decorativo debajo del título -->
                    <View
                        android:layout_width="65dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#A66A20" />

                    <!-- Nombre o descripción principal de la aplicación -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/settings_about_app"
                        android:textColor="#68451F"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!-- Descripción general de las funcionalidades de la aplicación -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_about_description"
                        android:textColor="#68451F"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <!-- Título de la sección dedicada a los desarrolladores -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/settings_about_developers_title"
                        android:textColor="#102B59"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!-- Información de los desarrolladores -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_about_developers"
                        android:textColor="#68451F"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <!-- Separador decorativo de la información final -->
                    <View
                        android:layout_width="65dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="12dp"
                        android:background="#A66A20" />

                    <!-- Idiomas disponibles en la aplicación -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/settings_about_languages"
                        android:textColor="#68451F"
                        android:textSize="12sp"
                        android:gravity="center" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN PARA VOLVER A LA PANTALLA ANTERIOR -->
    <!-- btnVolverAjustes permite gestionar la navegación desde Kotlin -->
    <ImageButton
        android:id="@+id/btnVolverAjustes"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/fondo_flecha_volver"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/button_back"
        android:padding="0dp" />

</FrameLayout>
