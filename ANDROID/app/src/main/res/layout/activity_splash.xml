<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Logo central -->
    <LinearLayout
        android:id="@+id/contenedorLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivLogoSplash"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_orden_auror" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:text="CENTRO DE DESCIFRADO MÁGICO"
            android:textColor="#DDB65C"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Destellos mágicos -->
    <TextView
        android:id="@+id/destello1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="110dp"
        android:text="✦"
        android:textColor="#FFD76A"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/destello2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="35dp"
        android:text="✧"
        android:textColor="#F6C453"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/destello3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="35dp"
        android:text="✦"
        android:textColor="#FFD76A"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/destello4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="115dp"
        android:text="✧"
        android:textColor="#F6C453"
        android:textSize="28sp" />

</FrameLayout>
