<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO DE BIBLIOTECA -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- OSCURECER EL FONDO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="20dp">

                <!-- CABECERA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="22dp"
                    android:background="@drawable/cabecera_orden">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aes_header_title"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:gravity="center" />

                    <View
                        android:layout_width="65dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="10dp"
                        android:background="#F2B82E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/aes_header_subtitle"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="0.12"
                        android:gravity="center" />

                </LinearLayout>

                <!-- TÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="@string/aes_received_files"
                    android:textColor="#F5BD36"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/aes_instructions"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <!-- PERGAMINO 1: ARCHIVO -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="185dp"
                    android:layout_marginTop="5dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fondo_tarjeta_pergamino"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="65dp"
                        android:paddingEnd="65dp"
                        android:paddingTop="25dp"
                        android:paddingBottom="25dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aes_file_section"
                            android:textColor="#09204C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvArchivoSeleccionado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/aes_no_file_selected"
                            android:textColor="#62513D"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnSeleccionarArchivo"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="@string/aes_select_image"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="@color/azul_hechicero" />

                    </LinearLayout>
                </FrameLayout>

                <!-- PERGAMINO 2: CONTRASEÑA -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:layout_marginTop="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fondo_tarjeta_pergamino"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingStart="85dp"
                        android:paddingEnd="85dp"
                        android:paddingTop="35dp"
                        android:paddingBottom="35dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/aes_password_section"
                            android:textColor="#09204C"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/aes_password_hint"
                            android:inputType="textPassword"
                            android:gravity="center"
                            android:singleLine="true"
                            android:textSize="14sp"
                            android:padding="6dp"
                            android:textColor="#09204C"
                            android:textColorHint="#75634E"
                            android:backgroundTint="#8B5425" />

                        <Button
                            android:id="@+id/btnDescifrar"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/aes_decrypt_button"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="@color/granate_magico" />

                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </ScrollView>

        <!-- BOTÓN VOLVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="65dp"
                android:layout_height="55dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
