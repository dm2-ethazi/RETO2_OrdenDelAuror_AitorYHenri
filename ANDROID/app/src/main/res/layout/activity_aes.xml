<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/azul_hechicero">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aes_header_title"
                android:textColor="@color/texto_claro"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@color/dorado_antiguo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/aes_header_subtitle"
                android:textColor="@color/texto_claro"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

        </LinearLayout>

        <!-- INFORMACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/aes_received_files"
            android:textColor="@color/azul_hechicero"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="@string/aes_instructions"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- SELECCIONAR ARCHIVO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/fondo_secundario"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aes_file_section"
                android:textColor="@color/azul_hechicero"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArchivoSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="15dp"
                android:text="@string/aes_no_file_selected"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSeleccionarArchivo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/aes_select_image"
                android:textAllCaps="false"
                android:textColor="@color/texto_claro"
                android:backgroundTint="@color/azul_hechicero" />

        </LinearLayout>

        <!-- CONTRASEÑA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/fondo_secundario"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aes_password_section"
                android:textColor="@color/azul_hechicero"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/aes_password_hint"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/azul_hechicero"
                android:textColorHint="@color/texto_secundario" />

            <Button
                android:id="@+id/btnDescifrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/aes_decrypt_button"
                android:textAllCaps="false"
                android:textColor="@color/texto_claro"
                android:backgroundTint="@color/granate_magico" />

        </LinearLayout>

        <!-- RESULTADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="@color/fondo_secundario"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aes_result_section"
                android:textColor="@color/azul_hechicero"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/aes_waiting_decryption"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivImagenDescifrada"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="15dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/aes_decrypted_image_description"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/aes_save_button"
                android:textAllCaps="false"
                android:textColor="@color/texto_claro"
                android:backgroundTint="@color/azul_hechicero"
                android:enabled="false" />

        </LinearLayout>

        <!-- BOTÓN VOLVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/button_back"
                android:textAllCaps="false"
                android:textColor="@color/texto_claro"
                android:backgroundTint="@color/granate_magico" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>