<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_principal">

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@color/granate_magico">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cesar_header_title"
                    android:textColor="@color/texto_claro"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/dorado_antiguo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cesar_header_subtitle"
                    android:textColor="@color/texto_claro"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

            </LinearLayout>

            <!-- INFORMACIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/cesar_received_files"
                android:textColor="@color/granate_magico"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="@string/cesar_instructions"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- SELECCIONAR ARCHIVO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@color/fondo_secundario"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cesar_file_section"
                    android:textColor="@color/granate_magico"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArchivoSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/cesar_no_file_selected"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSeleccionarArchivo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/cesar_select_file"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_claro"
                    android:backgroundTint="@color/granate_magico" />

            </LinearLayout>

            <!-- DESPLAZAMIENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:background="@color/fondo_secundario"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cesar_key_section"
                    android:textColor="@color/granate_magico"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cesar_shift_instructions"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etDesplazamiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/cesar_shift_hint"
                    android:inputType="number"
                    android:maxLength="2"
                    android:padding="12dp"
                    android:textColor="@color/granate_magico"
                    android:textColorHint="@color/texto_secundario" />

                <Button
                    android:id="@+id/btnDescifrar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/cesar_decrypt_button"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_claro"
                    android:backgroundTint="@color/granate_magico" />

            </LinearLayout>

            <!-- RESULTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@color/fondo_secundario"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cesar_result_section"
                    android:textColor="@color/granate_magico"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cesar_waiting_decryption"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTextoDescifrado"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="15dp"
                    android:gravity="top|start"
                    android:hint="@string/cesar_result_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/granate_magico"
                    android:textColorHint="@color/texto_secundario"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/cesar_save_button"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_claro"
                    android:backgroundTint="@color/granate_magico"
                    android:enabled="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTÓN VOLVER FIJO ABAJO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/fondo_principal">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/button_back"
            android:textAllCaps="false"
            android:textColor="@color/texto_claro"
            android:backgroundTint="@color/granate_magico" />

    </LinearLayout>

</LinearLayout>
