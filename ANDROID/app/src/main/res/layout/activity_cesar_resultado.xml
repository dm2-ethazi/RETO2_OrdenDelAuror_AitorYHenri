<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_biblioteca"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="5dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/cabecera_orden">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cesar_result_header_title"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="#F2B82E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cesar_result_header_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:gravity="center" />

        </LinearLayout>

        <!-- PERGAMINO DEL RESULTADO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo_tarjeta_pergamino"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <!-- ZONA INTERIOR DEL PERGAMINO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="62dp"
                android:paddingEnd="62dp"
                android:paddingTop="100dp"
                android:paddingBottom="85dp">

                <TextView
                    android:id="@+id/tvEstadoCesar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/cesar_decrypting"
                    android:textColor="#62513D"
                    android:textSize="14sp"
                    android:visibility="visible" />

                <ScrollView
                    android:id="@+id/scrollResultadoCesar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResultadoCesar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#593719"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"
                        android:textIsSelectable="true"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                </ScrollView>

            </FrameLayout>

        </FrameLayout>

        <!-- BOTONES GUARDAR Y COMPARTIR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btnGuardarCesar"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/cesar_save_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCompartirCesar"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/azul_hechicero"
                android:text="@string/share_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- BOTÓN VOLVER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingStart="18dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVolverResultado"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:src="@drawable/fondo_flecha_volver"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:contentDescription="@string/button_back" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
