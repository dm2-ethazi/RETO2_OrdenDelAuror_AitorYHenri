<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ordenDelAuror.aescipher.controller.MainController"
      alignment="CENTER"
      spacing="15">

    <Label text="Orden Del Auror"
           styleClass="title-label"/>

    <Button text="Seleccionar archivo"
            onAction="#selectFile"
            styleClass="file-button"/>

    <PasswordField
            fx:id="passwordField"
            promptText="Contraseña"/>

    <Button text="Cifrar"
            onAction="#encrypt"
            styleClass="encrypt-button"/>

    <Button text="Descifrar"
            onAction="#decrypt"
            styleClass="decrypt-button"/>

    <ProgressBar
            fx:id="progressBar"
            prefWidth="300"
            progress="0"/>

    <Label
            fx:id="progressLabel"
            text="Listo"/>

    <Label fx:id="statusLabel"
            text="Sin archivo seleccionado"/>

</VBox>