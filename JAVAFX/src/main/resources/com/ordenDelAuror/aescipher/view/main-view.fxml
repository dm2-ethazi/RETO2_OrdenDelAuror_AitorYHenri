<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ordenDelAuror.aescipher.controller.MainController"
      alignment="CENTER"
      spacing="15">

    <Label text="Orden Del Auror"
           styleClass="title-label"/>

    <Button text="Seleccionar archivo"
            styleClass="file-button"/>

    <PasswordField
            promptText="Contraseña"/>

    <Button text="Cifrar"
            styleClass="encrypt-button"/>

    <Button text="Descifrar"
            styleClass="decrypt-button"/>

    <Label text="Sin archivo seleccionado"/>

</VBox>